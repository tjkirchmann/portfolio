---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0c0b" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <ClientRouter fallback="none" />
    <script is:inline>
      // keep the CSS sheen (16 s period) in phase with the simulation's light, which is driven by
      // performance.now(); re-run after client-side navigation so new elements join in step
      (function () {
        var set = function () {
          document.documentElement.style.setProperty('--sheen-delay', -((performance.now() / 1000) % 16).toFixed(3) + 's');
        };
        set();
        document.addEventListener('astro:after-swap', set);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Pixel icons only look right on whole device pixels. Layout puts many of them at
      // fractional offsets (fluid gutters, centred rows), so nudge each by its remainder with the
      // `translate` property (separate from any `transform` a hover uses).
      const icons = () => document.querySelectorAll<SVGSVGElement>('svg[shape-rendering="crispEdges"]');
      let queued = false;
      function snap() {
        queued = false;
        const d = window.devicePixelRatio || 1;
        const list = Array.from(icons());
        list.forEach((s) => (s.style.translate = ''));
        // read everything, then write, so there is one layout pass
        const rs = list.map((s) => s.getBoundingClientRect());
        list.forEach((s, i) => {
          const fx = Math.round(rs[i].left * d) / d - rs[i].left;
          const fy = Math.round(rs[i].top * d) / d - rs[i].top;
          if (Math.abs(fx) > 0.001 || Math.abs(fy) > 0.001) s.style.translate = `${fx.toFixed(3)}px ${fy.toFixed(3)}px`;
        });
      }
      const later = () => {
        if (!queued) (queued = true), requestAnimationFrame(snap);
      };
      document.addEventListener('astro:page-load', later);
      window.addEventListener('resize', later);
      document.addEventListener('scroll', later, { capture: true, passive: true });
      document.fonts?.ready.then(later);
      new ResizeObserver(later).observe(document.documentElement);
    </script>
  </body>
</html>

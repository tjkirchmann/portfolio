---
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import Dither from '../components/Dither.astro';
import ToolMenu from '../components/ToolMenu.astro';
import RoomPanel from '../components/RoomPanel.astro';
import SimAbout from '../components/SimAbout.astro';
import Hints from '../components/Hints.astro';
import SkillsLink from '../components/SkillsLink.astro';
import MobilePlay from '../components/MobilePlay.astro';
import MobileScreens from '../components/MobileScreens.astro';
import Timeline from '../components/Timeline.astro';
import LinkRow from '../components/LinkRow.astro';
import { loadSite } from '../lib/site';

const site = loadSite();
// the phone tour: one step per item of the bottom row, in the row's order
const tourSteps = [
  ...site.links.filter((l) => l.hint).map((l) => ({ label: l.label, icon: l.icon, hint: l.hint!, href: l.href, download: l.download })),
  ...(site.skills ? [{ label: 'My Skills', icon: 'chart-bar', hint: 'Tap to see my skills', skills: true }] : []),
];
---

<Base title={site.name} description={`${site.name}, ${site.role}`}>
  <Split lock="fit" label="Animation">
    <Dither slot="art" />
    <ToolMenu slot="art" />
    <RoomPanel slot="art" />
    {site.about && <SimAbout slot="art" title={site.about.title} body={site.about.body} slots={site.links.length + (site.skills ? 1 : 0)} />}
    <Hints />
    <MobilePlay slot="art" />

    <header class="page-head home-head">
      <h1 class="page-title">{site.name}</h1>
      <p class="page-sub">{site.role}</p>
    </header>

    <div class="home-timelines" data-home-timelines>
      <div class="home-half" data-half="experiences" data-room-zone>
        <span class="hint home-hint" data-hint="experiences" data-tail="left" hidden>Hover one to read more</span>
        <Timeline label="Experiences" items={site.experiences} panel />
      </div>
      <div class="home-half" data-half="companies">
        <Timeline label="Companies" items={site.companies} />
      </div>
    </div>

    <footer class="home-foot">
      <LinkRow links={site.links} beside />
      {site.skills && <SkillsLink groups={site.skills} />}
    </footer>
  </Split>
  {/* outside the panes, so the phone screens cover the whole page */}
  <MobileScreens steps={tourSteps} />
</Base>

<style>
  .home-head {
    flex: none;
    margin-bottom: var(--space-6);
  }
  .home-timelines {
    flex: 1 1 0;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
  }
  .home-half {
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-5);
  }
  .home-half {
    position: relative;
  }
  /* sits on the label's row, after the word */
  .home-hint {
    position: absolute;
    top: -0.45em;
    left: 7rem;
  }
  .home-half > :global(.tl) {
    flex: 1 1 auto;
  }
  .home-foot {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-top: var(--space-4);
  }
  /* Desktop: the links and the skills icon leave the text column and stack down the right
     edge of the simulation, in one vertical bar with the question mark at its top. The bar's
     panel is drawn by SimAbout (inside the pane, --space-3 from its corner, --space-1 of
     padding, 2.25rem slots); these icons are placed over the slots under the question mark.
     Phones show the row at the top of the text, above the name. */
  @media (min-width: 800px) {
    /* the text column is its own layer and the art pane is laid out after it, so lift the
       column for the icons to show over the pane (the two never overlap otherwise) */
    :global(.split-text) {
      z-index: 1;
    }
    .home-foot {
      position: fixed;
      z-index: 3;
      top: calc(var(--pane-inset) + var(--space-3) + var(--space-1) + 2.25rem);
      right: calc(var(--pane-inset) + var(--space-3) + var(--space-1));
      width: 2.25rem;
      max-width: none;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: center;
      gap: 0;
      padding: 0;
    }
    .home-foot :global(.linkrow ul) {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
    }
    .home-foot :global(.linkrow a.is-icon),
    .home-foot :global(.skills-btn) {
      width: 2.25rem;
      height: 2.25rem;
      margin: 0;
      padding: 0;
      border-radius: 999px;
    }
    .home-foot :global(.linkrow a.is-icon:hover),
    .home-foot :global(.skills-btn:hover) {
      background: color-mix(in oklab, var(--emerald) 18%, transparent);
    }
    .home-half[data-half='companies'] {
      padding-bottom: 0;
    }
  }
  @media (max-width: 799.98px) {
    .home-timelines {
      display: block;
      flex: none;
    }
    .home-half {
      padding-bottom: var(--space-6);
    }
    .home-half :global(.tl-scroll) {
      overflow: visible;
      mask-image: none;
    }
    /* phones: the icon row sits at the top of the text, above the name */
    .home-foot {
      order: -1;
      padding-top: 0;
      margin-bottom: var(--space-5);
    }
  }
</style>

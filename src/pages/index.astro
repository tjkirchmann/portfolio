---
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import Dither from '../components/Dither.astro';
import ToolMenu from '../components/ToolMenu.astro';
import RoomPanel from '../components/RoomPanel.astro';
import SimAbout from '../components/SimAbout.astro';
import Hints from '../components/Hints.astro';
import SkillsLink from '../components/SkillsLink.astro';
import MobilePlay from '../components/MobilePlay.astro';
import MobileScreens from '../components/MobileScreens.astro';
import Timeline from '../components/Timeline.astro';
import LinkRow from '../components/LinkRow.astro';
import { loadSite } from '../lib/site';

const site = loadSite();
// the phone tour: one step per item of the bottom row, in the row's order
const tourSteps = [
  ...site.links.filter((l) => l.hint).map((l) => ({ label: l.label, icon: l.icon, hint: l.hint!, href: l.href, download: l.download })),
  ...(site.skills ? [{ label: 'My Skills', icon: 'chart-bar', hint: 'Tap to see my skills', skills: true }] : []),
];
---

<Base title={site.name} description={`${site.name}, ${site.role}`}>
  <Split lock="fit" label="Animation">
    <Dither slot="art" />
    <ToolMenu slot="art" />
    <RoomPanel slot="art" />
    {site.about && <SimAbout slot="art" title={site.about.title} body={site.about.body} />}
    <Hints />
    <MobilePlay slot="art" />

    <header class="page-head home-head">
      <h1 class="page-title">{site.name}</h1>
      <p class="page-sub">{site.role}</p>
    </header>

    <div class="home-timelines" data-home-timelines>
      <div class="home-half" data-half="experiences" data-room-zone>
        <span class="hint home-hint" data-hint="experiences" data-tail="left" hidden>Hover one to read more</span>
        <Timeline label="Experiences" items={site.experiences} panel />
      </div>
      <div class="home-half" data-half="companies">
        <Timeline label="Companies" items={site.companies} />
      </div>
    </div>

    <footer class="home-foot">
      <LinkRow links={site.links} below />
      {site.skills && <SkillsLink groups={site.skills} />}
    </footer>
  </Split>
  {/* outside the panes, so the phone screens cover the whole page */}
  <MobileScreens steps={tourSteps} />
</Base>

<style>
  .home-head {
    flex: none;
    margin-bottom: var(--space-6);
  }
  .home-timelines {
    flex: 1 1 0;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
  }
  .home-half {
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-5);
  }
  .home-half {
    position: relative;
  }
  /* sits on the label's row, after the word */
  .home-hint {
    position: absolute;
    top: -0.45em;
    left: 7rem;
  }
  .home-half > :global(.tl) {
    flex: 1 1 auto;
  }
  .home-foot {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-top: var(--space-4);
  }
  /* Desktop: the row of links and the skills icon leaves the text column and sits at the top
     right of the simulation, in one bar beside the question mark (which is 2.25rem wide, at
     --space-3 from the pane's corner). Phones keep it at the bottom of the page. */
  @media (min-width: 800px) {
    /* the text column is its own layer and the art pane is laid out after it, so lift the
       column for the bar to show over the pane (the two never overlap otherwise) */
    :global(.split-text) {
      z-index: 1;
    }
    .home-foot {
      position: fixed;
      z-index: 3;
      top: calc(var(--pane-inset) + var(--space-3));
      right: calc(var(--pane-inset) + var(--space-3) + 2.25rem + var(--space-2));
      width: auto;
      max-width: none;
      height: 2.25rem;
      flex-wrap: nowrap;
      align-items: center;
      gap: var(--space-3);
      padding: 0 var(--space-3);
      border-radius: 999px;
      background: color-mix(in oklab, var(--bg) 82%, transparent);
      box-shadow: 0 0 0 1px color-mix(in oklab, var(--emerald) 22%, transparent);
    }
    .home-foot :global(.linkrow ul) {
      flex-wrap: nowrap;
      gap: var(--space-3);
    }
    .home-half[data-half='companies'] {
      padding-bottom: 0;
    }
  }
  @media (max-width: 799.98px) {
    .home-timelines {
      display: block;
      flex: none;
    }
    .home-half {
      padding-bottom: var(--space-6);
    }
    .home-half :global(.tl-scroll) {
      overflow: visible;
      mask-image: none;
    }
    .home-foot {
      padding-top: var(--space-4);
    }
  }
</style>

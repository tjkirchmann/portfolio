---
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import Art from '../components/Art.astro';
import Dither from '../components/Dither.astro';
import EntryList from '../components/EntryList.astro';
import LinkRow from '../components/LinkRow.astro';
import BackLink from '../components/BackLink.astro';
import PostList from '../components/PostList.astro';
import Prose from '../components/Prose.astro';
import { Content as Sample } from '../blocks/sample.md';
import { getPosts } from '../lib/posts';
import { loadSite } from '../lib/site';

const site = loadSite();
const posts = await getPosts();
const palette = ['bg', 'ink', 'emerald', 'teal', 'deep', 'leaf', 'gold', 'copper', 'bronze'];
---

<Base title="Blocks" noindex>
  <Split mirror label="Split, Art over Dither">
    <BackLink slot="art-top" href="/" label="Home" />
    <Fragment slot="art">
      <Dither />
      <Art slug={site.art} />
    </Fragment>

    <header class="page-head">
      <h1 class="page-title">Blocks</h1>
    </header>

    <section aria-labelledby="b-palette">
      <h2 id="b-palette">Palette</h2>
      <ul class="swatches">
        {
          palette.map((p) => (
            <li>
              <span class="swatch" style={`background: var(--${p})`} />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="b-dither">
      <h2 id="b-dither">Dither</h2>
      <div class="tiles">
        <div class="tile"><Dither /></div>
        <div class="tile">
          <Dither
            stops={[
              { color: '#0a0c0b', at: 0 },
              { color: '#85692c', at: 0.7 },
              { color: '#bbc368', at: 1 },
            ]}
            direction="to right"
            cell={4}
          />
        </div>
        <div class="tile">
          <Dither
            stops={[
              { color: '#326e54', at: 0 },
              { color: '#0a0c0b', at: 0.55 },
              { color: '#9f814e', at: 1 },
            ]}
            direction={135}
            cell={2}
          />
        </div>
      </div>
    </section>

    <section aria-labelledby="b-art">
      <h2 id="b-art">Art over Dither</h2>
      <div class="stage" data-test="art-over-dither">
        <Dither
          stops={[
            { color: '#0a0c0b', at: 0 },
            { color: '#326e54', at: 0.6 },
            { color: '#76c8a5', at: 1 },
          ]}
          direction="to top"
        />
        <Art slug="does-not-exist" />
      </div>
    </section>

    <section aria-labelledby="b-entries">
      <h2 id="b-entries">EntryList</h2>
      <EntryList entries={site.entries} />
    </section>

    <section aria-labelledby="b-posts">
      <h2 id="b-posts">PostList</h2>
      <PostList posts={posts} />
    </section>

    <section aria-labelledby="b-links">
      <h2 id="b-links">LinkRow</h2>
      <LinkRow links={site.links} label="Sample links" />
    </section>

    <section aria-labelledby="b-back">
      <h2 id="b-back">BackLink</h2>
      <div class="backdemo"><BackLink href="/blog/" label="Blog" /></div>
    </section>

    <section aria-labelledby="b-prose">
      <h2 id="b-prose">Prose</h2>
      <Prose>
        <Sample />
      </Prose>
    </section>
  </Split>
</Base>

<style>
  section {
    margin-bottom: var(--space-8);
    max-width: 36rem;
  }
  section > h2 {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-3);
    margin-bottom: var(--space-4);
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .swatches li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .swatch {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ink) 14%, transparent);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .tile,
  .stage,
  .backdemo {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: #0c0f0e;
  }
  .tile {
    aspect-ratio: 1;
  }
  .stage {
    height: 22rem;
    display: grid;
    place-items: center;
    container-type: size;
  }
  .backdemo {
    padding: var(--space-5);
  }
</style>

---
import Base from '../layouts/Base.astro';
import Split from '../components/Split.astro';
import Art from '../components/Art.astro';
import ArtSet from '../components/ArtSet.astro';
import Dither from '../components/Dither.astro';
import EntryList from '../components/EntryList.astro';
import Timeline from '../components/Timeline.astro';
import LinkRow from '../components/LinkRow.astro';
import BackLink from '../components/BackLink.astro';
import PostList from '../components/PostList.astro';
import Prose from '../components/Prose.astro';
import { Content as Sample } from '../blocks/sample.md';
import { getPosts } from '../lib/posts';
import { loadSite } from '../lib/site';
import { artList, type ArtField } from '../lib/art-set';
import { icon } from '../lib/icons';

const site = loadSite();

// Icon pack candidates (AC-54): the same items in each pack, keyed by the current lucide
// name. Where a pack has no close match the nearest glyph stands in.
const ITEMS = ['users', 'handshake', 'megaphone', 'wrench', 'network', 'gamepad-2', 'scale', 'bird', 'package', 'trophy', 'paintbrush', 'orbit', 'bomb', 'rotate-ccw', 'chevron-left', 'mail'] as const;
type Item = (typeof ITEMS)[number];
const PACKS: { name: string; map: Record<Item, string> }[] = [
  { name: 'Lucide', map: Object.fromEntries(ITEMS.map((n) => [n, n])) as Record<Item, string> },
  ...(['regular', 'duotone'] as const).map((v) => {
    const ph: Record<Item, string> = { users: 'users', handshake: 'handshake', megaphone: 'megaphone', wrench: 'wrench', network: 'network', 'gamepad-2': 'game-controller', scale: 'scales', bird: 'bird', package: 'package', trophy: 'trophy', paintbrush: 'paint-brush', orbit: 'planet', bomb: 'bomb', 'rotate-ccw': 'arrow-counter-clockwise', 'chevron-left': 'caret-left', mail: 'envelope' };
    return {
      name: v === 'regular' ? 'Phosphor' : 'Phosphor duotone',
      map: Object.fromEntries(ITEMS.map((n) => [n, `ph:${ph[n]}${v === 'duotone' ? '-duotone' : ''}`])) as Record<Item, string>,
    };
  }),
  { name: 'Tabler', map: { users: 'tabler:users', handshake: 'tabler:heart-handshake', megaphone: 'tabler:speakerphone', wrench: 'tabler:tool', network: 'tabler:network', 'gamepad-2': 'tabler:device-gamepad-2', scale: 'tabler:scale', bird: 'tabler:feather', package: 'tabler:package', trophy: 'tabler:trophy', paintbrush: 'tabler:brush', orbit: 'tabler:planet', bomb: 'tabler:bomb', 'rotate-ccw': 'tabler:rotate', 'chevron-left': 'tabler:chevron-left', mail: 'tabler:mail' } },
  { name: 'Pixelarticons', map: { users: 'pixelarticons:users', handshake: 'pixelarticons:hand', megaphone: 'pixelarticons:megaphone', wrench: 'pixelarticons:tools', network: 'pixelarticons:share', 'gamepad-2': 'pixelarticons:gamepad', scale: 'pixelarticons:briefcase', bird: 'pixelarticons:feather', package: 'pixelarticons:package', trophy: 'pixelarticons:trophy', paintbrush: 'pixelarticons:brush', orbit: 'pixelarticons:bullseye', bomb: 'pixelarticons:bomb', 'rotate-ccw': 'pixelarticons:undo', 'chevron-left': 'pixelarticons:chevron-left', mail: 'pixelarticons:mail' } },
  { name: 'Iconoir', map: { users: 'iconoir:group', handshake: 'iconoir:user-love', megaphone: 'iconoir:megaphone', wrench: 'iconoir:wrench', network: 'iconoir:network', 'gamepad-2': 'iconoir:gamepad', scale: 'iconoir:open-book', bird: 'iconoir:twitter', package: 'iconoir:package', trophy: 'iconoir:trophy', paintbrush: 'iconoir:design-pencil', orbit: 'iconoir:planet', bomb: 'iconoir:fire-flame', 'rotate-ccw': 'iconoir:refresh', 'chevron-left': 'iconoir:nav-arrow-left', mail: 'iconoir:mail' } },
];
const packRows = (map: Record<Item, string>) => ({
  experiences: site.experiences.map((e) => ({ ...e, body: undefined, icon: map[(e.icon ?? 'users') as Item] ?? e.icon })),
  companies: site.companies.map((e) => ({ ...e, body: undefined, icon: map[(e.icon ?? 'users') as Item] ?? e.icon })),
});
const TOOL_ITEMS: Item[] = ['paintbrush', 'orbit', 'bomb', 'rotate-ccw', 'chevron-left', 'mail'];
// Archived: the ball pieces and their switcher no longer appear on the site. They live here.
const archivedArt: ArtField = site.art ?? [
  { none: true, icon: 'grid-3-x-3', label: 'Life' },
  { slug: 'waveball', icon: 'globe', label: 'Wave ball' },
  { slug: 'spikeball', icon: 'asterisk', label: 'Spike ball' },
  { slug: 'spikeball-life', icon: 'sparkles', label: 'Spike ball, life', backdrop: false },
  { slug: 'waveball-life', icon: 'waves', label: 'Wave ball, life', backdrop: false },
];
const posts = await getPosts();
const palette = ['bg', 'ink', 'emerald', 'teal', 'deep'];
const entries = [
  { label: 'Row one', detail: '2026', href: '/blog/' },
  { label: 'Row two', detail: '2025' },
];
const many = Array.from({ length: 12 }, (_, i) => ({
  title: `Project ${['one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'][i]}`,
  year: 2026 - i,
  icon: ['box', 'layers', 'shapes', 'cpu', 'pen-tool', 'globe'][i % 6],
}));
---

<Base title="Blocks" noindex>
  <Split mirror label="Split, Art over Dither">
    <BackLink slot="art-top" href="/" label="Home" />
    <Fragment slot="art">
      <Dither />
      <ArtSet art={[...artList(archivedArt), { slug: '_placeholder-stacked', icon: 'circle', label: 'Opaque placeholder', backdrop: true }]} />
    </Fragment>

    <header class="page-head">
      <h1 class="page-title">Blocks</h1>
    </header>

    <section aria-labelledby="b-palette">
      <h2 id="b-palette">Palette</h2>
      <ul class="swatches">
        {
          palette.map((p) => (
            <li>
              <span class="swatch" style={`background: var(--${p})`} />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="b-dither">
      <h2 id="b-dither">Dither</h2>
      <div class="stage tall" data-test="dither-life">
        <Dither seed="blocks-life" />
      </div>
    </section>

    <section aria-labelledby="b-art">
      <h2 id="b-art">Art over Dither</h2>
      <div class="stage" data-test="art-over-dither">
        <Dither seed="blocks-art" intensity={0.7} />
        <Art slug="does-not-exist" />
      </div>
    </section>

    <section aria-labelledby="b-opaque">
      <h2 id="b-opaque">Opaque art over Dither</h2>
      <div class="stage" data-test="opaque-over-dither">
        <Dither seed="blocks-opaque" intensity={0.7} />
        <Art slug="_placeholder-stacked" />
      </div>
    </section>

    <section aria-labelledby="b-timeline">
      <h2 id="b-timeline">Timeline</h2>
      <div class="tl-demos">
        <div class="tl-box" data-test="timeline-companies">
          <Timeline label="Companies" id="tl-demo-companies" items={site.companies} />
        </div>
        <div class="tl-box tl-box-overflow" data-test="timeline-overflow">
          <Timeline label="Projects" id="tl-demo-overflow" items={many} />
        </div>
      </div>
    </section>

    <section aria-labelledby="b-entries">
      <h2 id="b-entries">EntryList</h2>
      <EntryList entries={entries} />
    </section>

    <section aria-labelledby="b-posts">
      <h2 id="b-posts">PostList</h2>
      <PostList posts={posts} />
    </section>

    <section aria-labelledby="b-links">
      <h2 id="b-links">LinkRow</h2>
      <LinkRow links={site.links} label="Sample links" />
    </section>

    <section aria-labelledby="b-back">
      <h2 id="b-back">BackLink</h2>
      <div class="backdemo"><BackLink href="/blog/" label="Blog" /></div>
    </section>

    <section aria-labelledby="b-packs" class="packs-section">
      <h2 id="b-packs">Icon packs</h2>
      <div class="packs" tabindex="0" aria-labelledby="b-packs">
        {
          PACKS.map((p, k) => {
            const rows = packRows(p.map);
            return (
              <div class="pack">
                <h3 class="pack-name">{p.name}</h3>
                <div class="pack-tools">
                  {TOOL_ITEMS.map((n) => (
                    <span class="pack-icon" set:html={icon(p.map[n], 18)} />
                  ))}
                </div>
                <Timeline label="Experiences" id={`pk-${k}-exp`} items={rows.experiences} />
                <Timeline label="Companies" id={`pk-${k}-co`} items={rows.companies} />
              </div>
            );
          })
        }
      </div>
    </section>

    <section aria-labelledby="b-prose">
      <h2 id="b-prose">Prose</h2>
      <Prose>
        <Sample />
      </Prose>
    </section>
  </Split>
</Base>

<style>
  .packs-section {
    max-width: none;
  }
  .packs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 17rem;
    gap: var(--space-6);
    overflow-x: auto;
    padding-bottom: var(--space-3);
    scrollbar-width: thin;
  }
  .pack {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .pack-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
  }
  .pack-tools {
    display: flex;
    gap: var(--space-3);
    color: var(--emerald);
  }
  .pack-icon :global(svg) {
    display: block;
  }
  section {
    margin-bottom: var(--space-8);
    max-width: 36rem;
  }
  section > h2 {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-3);
    margin-bottom: var(--space-4);
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .swatches li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .swatch {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ink) 14%, transparent);
  }
  .stage.tall {
    height: 26rem;
  }
  .tl-demos {
    display: grid;
    gap: var(--space-6);
  }
  .tl-box-overflow {
    height: 16rem;
    display: flex;
    flex-direction: column;
  }
  .tl-box-overflow > :global(.tl) {
    flex: 1 1 auto;
  }
  .stage,
  .backdemo {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: #0c0f0e;
  }
  .stage {
    height: 22rem;
    clip-path: inset(0 round 10px);
    display: grid;
    place-items: center;
    container-type: size;
  }
  .backdemo {
    padding: var(--space-5);
  }
</style>

---
import Base from '../../layouts/Base.astro';
import Split from '../../components/Split.astro';
import Art from '../../components/Art.astro';
import Dither from '../../components/Dither.astro';
import BackLink from '../../components/BackLink.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
import { loadSite } from '../../lib/site';

const site = loadSite();
const posts = await getPosts();
---

<Base title={`Blog · ${site.name}`}>
  <Split mirror label="Animation">
    <BackLink slot="art-top" href="/" label="Home" />
    <Fragment slot="art">
      <Dither />
      <Art slug={site.art} />
    </Fragment>

    <header class="page-head">
      <h1 class="page-title">Blog</h1>
    </header>
    <PostList posts={posts} />
  </Split>
</Base>

---
/**
 * The question mark at the top right of the home life simulation. Hovering or focusing it
 * opens the same text panel the experiences use (RoomPanel reads the hidden title and body
 * here), with the text from `about` in site.yaml. Wide pointer screens only.
 */
import Prose from './Prose.astro';
import { icon } from '../lib/icons';
import { markdownToHtml } from 'satteri';

interface Props {
  title: string;
  body?: string;
  /**
   * How many icon links share this panel. With a number, the question mark is the top slot of
   * a vertical bar and that many 2.25rem slots are left under it; the page places its links
   * over them (see the home page).
   */
  slots?: number;
}
const { title, body = '', slots = 0 } = Astro.props;
const html = body.trim() ? markdownToHtml(body).html : '';
---

<div class="about" data-tl-item="about" data-bar={slots ? '' : undefined} style={slots ? `--bar-slots:${slots}` : undefined}>
  <span class="hint about-hint" data-hint="about" data-tail="right" hidden>What is this?</span>
  {/* the same line on hover or focus, like the links under it (not while the step above shows) */}
  <span class="hint about-tip" data-tail="right" aria-hidden="true">What is this?</span>
  <button type="button" class="about-btn" data-tl-open aria-expanded="false" aria-label={title} set:html={icon('circle-question', 24)} />
  <span class="tl-title" hidden>{title}</span>
  {
    html && (
      <div data-tl-more hidden>
        <Prose>
          <Fragment set:html={html} />
        </Prose>
      </div>
    )
  }
</div>

<style>
  .about {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 2;
    display: none;
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 800px) {
    .about {
      display: block;
    }
  }
  .about-hint {
    position: absolute;
    right: calc(100% + var(--space-3));
    top: calc(var(--bar-pad, 0px) + 1.125rem);
    transform: translateY(-50%);
  }
  .about-tip {
    position: absolute;
    right: calc(100% + var(--space-3));
    top: calc(var(--bar-pad, 0px) + 1.125rem);
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    animation: none;
    transition: opacity var(--dur-1) var(--ease), visibility 0s linear var(--dur-1);
  }
  .about:hover > .about-tip,
  .about:focus-within > .about-tip {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .about:has(.about-hint:not([hidden])) > .about-tip {
    display: none;
  }
  .about-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--emerald) 22%, transparent);
    color: var(--emerald);
    cursor: help;
    transition: background-color var(--dur-1) var(--ease);
  }
  .about-btn:hover,
  .about[data-open] .about-btn {
    background: color-mix(in oklab, var(--emerald) 18%, var(--bg));
  }
  .about-btn :global(svg) {
    display: block;
  }
  /* as a bar: the panel is the tall pill, the question mark its first slot */
  .about[data-bar] {
    --bar-pad: var(--space-1);
    width: calc(2.25rem + 2 * var(--bar-pad));
    height: calc((var(--bar-slots) + 1) * 2.25rem + 2 * var(--bar-pad));
    padding: var(--bar-pad);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--emerald) 22%, transparent);
  }
  .about[data-bar] .about-btn {
    background: none;
    box-shadow: none;
  }
  .about[data-bar] .about-btn:hover,
  .about[data-bar][data-open] .about-btn {
    background: color-mix(in oklab, var(--emerald) 18%, transparent);
  }
  .about-btn:focus-visible {
    outline: 2px solid var(--emerald);
    outline-offset: 0;
  }
</style>

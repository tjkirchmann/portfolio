---
/** Back arrow for the top of the art pane. */
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a class="back" href={href} data-back>
  <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none">
    <path d="M10.5 4.5 6 9l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: 2.25rem;
    padding: 0 var(--space-3) 0 var(--space-2);
    border-radius: 999px;
    font-size: var(--text-sm);
    color: var(--ink);
    background: color-mix(in oklab, var(--bg) 62%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid color-mix(in oklab, var(--ink) 10%, transparent);
    transition:
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }
  .back:hover {
    color: var(--emerald);
    border-color: color-mix(in oklab, var(--emerald) 40%, transparent);
  }
  .back svg {
    transition: transform var(--dur-2) var(--ease);
  }
  .back:hover svg {
    transform: translateX(-2px);
  }
  .back:focus-visible {
    outline-offset: 2px;
    border-radius: 999px;
  }
</style>

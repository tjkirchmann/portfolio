---
/**
 * A slowly evolving life-like field, drawn through an 8x8 Bayer dither as crisp square cells.
 * Dense regions are solid, edges break into ordered halftone, empty space is pure --bg.
 * Colour follows how long a place has been occupied: deep/teal when young, emerald, then
 * leaf, gold and copper where the mass is oldest.
 *
 * The field is pre-evolved at build time (seeded from the page) and shipped as a small state
 * string, so the first paint is already a settled pattern. In the browser it steps ~10 times
 * a second, and pauses off-screen, in hidden tabs, when the mobile art has dissolved, and
 * always under prefers-reduced-motion.
 */
import { createSim, encodeState, WARMUP, MODES, type Mode } from '../lib/dither-sim';

interface Props {
  mode?: Mode;
  /** CSS px per cell (snapped to whole device pixels) */
  cell?: number;
  /** pattern seed; defaults to the page path so each page has its own */
  seed?: string;
  /** 0..1 brightness of the palette, to keep art on top readable */
  intensity?: number;
  /** steps per second */
  rate?: number;
  class?: string;
}
const { mode = 'life', cell = 6, seed = Astro.url.pathname, intensity = 1, rate = 10, class: className } = Astro.props;
if (!MODES.includes(mode)) throw new Error(`Dither: unknown mode "${mode}" (use ${MODES.join(', ')})`);
const sim = createSim(mode, seed);
for (let i = 0; i < WARMUP[mode]; i++) sim.step();
const state = encodeState(sim);
---

<div class:list={['dither', className]} data-dither-box>
  <canvas
    data-dither
    data-mode={mode}
    data-seed={seed}
    data-cell={cell}
    data-intensity={intensity}
    data-rate={rate}
    data-state={state}
    aria-hidden="true"></canvas>
</div>

<style>
  .dither {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg);
  }
  canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
</style>

<script>
  import { createSim, decodeState, draw, makeMapping, rampColours, RAMP, type Mapping, type Mode, type Sim } from '../lib/dither-sim';

  interface Inst {
    canvas: HTMLCanvasElement;
    sim: Sim;
    map?: Mapping;
    img?: ImageData;
    ctx: CanvasRenderingContext2D;
    lut: Uint8Array;
    inView: boolean;
    steps: number;
    ms: number;
    maxMs: number;
  }

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let insts: Inst[] = [];
  let timer = 0;
  let timerRate = 0;
  let io: IntersectionObserver | undefined;
  let ro: ResizeObserver | undefined;

  function layout(it: Inst) {
    const box = it.canvas.parentElement!;
    const r = box.getBoundingClientRect();
    if (!r.width || !r.height) return false;
    const dpr = window.devicePixelRatio || 1;
    const cellDev = Math.max(1, Math.round(Number(it.canvas.dataset.cell || 6) * dpr));
    const cellCss = cellDev / dpr;
    const cols = Math.ceil(r.width / cellCss);
    const rows = Math.ceil(r.height / cellCss);
    if (it.map && it.map.cols === cols && it.map.rows === rows) return true;
    it.canvas.width = cols;
    it.canvas.height = rows;
    it.canvas.style.width = `${cols * cellCss}px`;
    it.canvas.style.height = `${rows * cellCss}px`;
    // land cell edges on whole device pixels
    const fx = (r.left * dpr) % 1, fy = (r.top * dpr) % 1;
    it.canvas.style.transform = fx || fy ? `translate(${-fx / dpr}px, ${-fy / dpr}px)` : '';
    it.map = makeMapping(it.sim, cols, rows);
    it.img = it.ctx.createImageData(cols, rows);
    return true;
  }

  function render(it: Inst) {
    if (!it.map && !layout(it)) return;
    const empty = draw(it.sim, it.map!, it.lut, it.img!.data);
    it.ctx.putImageData(it.img!, 0, 0);
    it.canvas.dataset.empty = empty.toFixed(3);
  }

  const running = (it: Inst) =>
    it.inView && !document.hidden && !reduce.matches && !it.canvas.closest('[data-dissolved]');

  function tick() {
    let any = false;
    for (const it of insts) {
      if (!running(it)) continue;
      any = true;
      const t0 = performance.now();
      it.sim.step();
      render(it);
      const dt = performance.now() - t0;
      it.steps++;
      it.ms += dt;
      if (dt > it.maxMs) it.maxMs = dt;
      it.canvas.dataset.steps = String(it.steps);
      it.canvas.dataset.avgMs = (it.ms / it.steps).toFixed(3);
      it.canvas.dataset.maxMs = it.maxMs.toFixed(3);
    }
    if (!any) schedule();
  }

  /** run the shared timer only while at least one field is live */
  function schedule() {
    const live = insts.filter(running);
    const rate = live.length ? Math.max(...live.map((it) => Number(it.canvas.dataset.rate || 10))) : 0;
    if (rate === timerRate) return;
    clearInterval(timer);
    timerRate = rate;
    if (rate) timer = window.setInterval(tick, 1000 / rate);
    document.documentElement.dataset.ditherLive = String(live.length);
  }

  function teardown() {
    clearInterval(timer);
    timerRate = 0;
    io?.disconnect();
    ro?.disconnect();
    insts = [];
  }

  function init() {
    teardown();
    io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const it = insts.find((i) => i.canvas === e.target);
        if (it) it.inView = e.isIntersecting;
      }
      schedule();
    });
    ro = new ResizeObserver((entries) => {
      for (const e of entries) {
        const it = insts.find((i) => i.canvas.parentElement === e.target);
        if (it && layout(it)) render(it);
      }
    });
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-dither]').forEach((canvas) => {
      const sim = createSim(canvas.dataset.mode as Mode, canvas.dataset.seed || '/');
      decodeState(sim, canvas.dataset.state || '');
      const it: Inst = {
        canvas,
        sim,
        ctx: canvas.getContext('2d')!,
        lut: rampColours(RAMP, Number(canvas.dataset.intensity || 1)),
        inView: false,
        steps: 0,
        ms: 0,
        maxMs: 0,
      };
      insts.push(it);
      layout(it);
      render(it);
      io!.observe(canvas);
      ro!.observe(canvas.parentElement!);
    });
    schedule();
  }

  document.addEventListener('visibilitychange', schedule);
  document.addEventListener('split:dissolve', schedule);
  reduce.addEventListener('change', schedule);
  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('astro:page-load', init);
</script>

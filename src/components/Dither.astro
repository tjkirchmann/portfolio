---
/**
 * Ordered (8x8 Bayer) dither of a gradient between palette colours, drawn once to a canvas at
 * device pixel ratio. Static: it redraws only when its box changes size, never on a loop.
 */
interface Stop {
  color: string;
  at: number; // 0..1 along the direction
}
interface Props {
  stops?: Stop[];
  cell?: number; // CSS px per dither cell
  direction?: 'to top' | 'to bottom' | 'to left' | 'to right' | number; // number = degrees, CSS-style
  class?: string;
}
const {
  stops = [
    { color: '#0a0c0b', at: 0 },
    { color: '#0c1210', at: 0.35 },
    { color: '#102019', at: 0.62 },
    { color: '#173426', at: 0.84 },
    { color: '#21493a', at: 1 },
  ],
  cell = 3,
  direction = 'to bottom',
  class: className,
} = Astro.props;
const angle = typeof direction === 'number'
  ? direction
  : { 'to top': 0, 'to right': 90, 'to bottom': 180, 'to left': 270 }[direction];
---

<canvas
  class:list={['dither', className]}
  data-dither
  data-stops={JSON.stringify(stops)}
  data-cell={cell}
  data-angle={angle}
  aria-hidden="true"></canvas>

<style>
  .dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
  }
</style>

<script>
  const BAYER = [
    0, 32, 8, 40, 2, 34, 10, 42,
    48, 16, 56, 24, 50, 18, 58, 26,
    12, 44, 4, 36, 14, 46, 6, 38,
    60, 28, 52, 20, 62, 30, 54, 22,
    3, 35, 11, 43, 1, 33, 9, 41,
    51, 19, 59, 27, 49, 17, 57, 25,
    15, 47, 7, 39, 13, 45, 5, 37,
    63, 31, 55, 23, 61, 29, 53, 21,
  ];

  type Stop = { color: string; at: number };

  function hex(c: string): [number, number, number] {
    const h = c.replace('#', '');
    const n = parseInt(h.length === 3 ? h.split('').map((x) => x + x).join('') : h, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  function draw(canvas: HTMLCanvasElement) {
    const rect = canvas.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 3);
    const W = Math.round(rect.width * dpr);
    const H = Math.round(rect.height * dpr);
    const key = `${W}x${H}`;
    if (canvas.dataset.drawn === key) return;

    const cellPx = Math.max(1, Math.round(Number(canvas.dataset.cell || 3) * dpr));
    const cols = Math.ceil(W / cellPx);
    const rows = Math.ceil(H / cellPx);
    const stops: Stop[] = JSON.parse(canvas.dataset.stops || '[]').sort((a: Stop, b: Stop) => a.at - b.at);
    const rgb = stops.map((s) => hex(s.color));
    const rad = (Number(canvas.dataset.angle || 0) * Math.PI) / 180;
    // CSS gradient angle: 0deg points up, 90deg points right
    const dx = Math.sin(rad);
    const dy = -Math.cos(rad);
    const half = (Math.abs(cols * dx) + Math.abs(rows * dy)) / 2;

    const small = document.createElement('canvas');
    small.width = cols;
    small.height = rows;
    const sctx = small.getContext('2d')!;
    const img = sctx.createImageData(cols, rows);
    const d = img.data;
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        const px = x + 0.5 - cols / 2;
        const py = y + 0.5 - rows / 2;
        const t = Math.min(1, Math.max(0, ((px * dx + py * dy) / (half || 1) + 1) / 2));
        let i = 0;
        while (i < stops.length - 2 && t > stops[i + 1].at) i++;
        const a = stops[i];
        const b = stops[i + 1] ?? a;
        const f = b.at === a.at ? 0 : Math.min(1, Math.max(0, (t - a.at) / (b.at - a.at)));
        const threshold = (BAYER[(y & 7) * 8 + (x & 7)] + 0.5) / 64;
        const c = f > threshold ? rgb[i + 1] ?? rgb[i] : rgb[i];
        const o = (y * cols + x) * 4;
        d[o] = c[0];
        d[o + 1] = c[1];
        d[o + 2] = c[2];
        d[o + 3] = 255;
      }
    }
    sctx.putImageData(img, 0, 0);

    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext('2d')!;
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(small, 0, 0, cols * cellPx, rows * cellPx);
    canvas.dataset.drawn = key;
  }

  let ro: ResizeObserver | undefined;
  const pending = new Set<HTMLCanvasElement>();
  let timer = 0;

  function init() {
    ro?.disconnect();
    ro = new ResizeObserver((entries) => {
      entries.forEach((e) => pending.add(e.target as HTMLCanvasElement));
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        pending.forEach(draw);
        pending.clear();
      }, 120);
    });
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-dither]').forEach((c) => {
      draw(c);
      ro!.observe(c);
    });
  }

  document.addEventListener('astro:page-load', init);
</script>

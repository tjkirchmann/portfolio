---
/**
 * Conway's Life at display resolution, one automaton cell per drawn square. Live cells are
 * solid emerald; a cell that dies leaves a trail that thins out through an 8x8 Bayer dither
 * (teal, then deep, then gone). Nothing is blurred or upscaled.
 *
 * The field is seeded from the page and pre-evolved at build time, then shipped as a small
 * state string, so the first paint is already a settled pattern. In the browser it steps
 * about 10 times a second and pauses off-screen, in hidden tabs, when the mobile art has
 * dissolved, and always under prefers-reduced-motion. Only whole cells are drawn, centred in
 * the box, so nothing is cut at the edges.
 */
import { createLife, encodeState, WARMUP } from '../lib/dither-sim';

interface Props {
  /** CSS px per cell (snapped to whole device pixels) */
  cell?: number;
  /** pattern seed; defaults to the page path so each page has its own */
  seed?: string;
  /** 0..1 strength of the greens over --bg, to keep the art on top the subject */
  intensity?: number;
  /** steps per second */
  rate?: number;
  class?: string;
}
const { cell = 6, seed = Astro.url.pathname, intensity = 1, rate = 10, class: className } = Astro.props;
const life = createLife(seed);
for (let i = 0; i < WARMUP; i++) life.step();
const state = encodeState(life);
---

<div class:list={['dither', className]} data-dither-box>
  <canvas
    data-dither
    data-seed={seed}
    data-cell={cell}
    data-intensity={intensity}
    data-rate={rate}
    data-state={state}
    aria-hidden="true"></canvas>
</div>

<style>
  .dither {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    background: var(--bg);
  }
  canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
</style>

<script>
  import { createLife, decodeState, draw, colours, type Life } from '../lib/dither-sim';

  interface Inst {
    canvas: HTMLCanvasElement;
    life: Life;
    cols: number;
    rows: number;
    img?: ImageData;
    ctx: CanvasRenderingContext2D;
    pal: Uint8Array;
    inView: boolean;
    steps: number;
    ms: number;
    maxMs: number;
  }

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let insts: Inst[] = [];
  let timer = 0;
  let timerRate = 0;
  let io: IntersectionObserver | undefined;
  let ro: ResizeObserver | undefined;

  /** whole cells only, centred, cell edges on device pixels */
  function layout(it: Inst) {
    const box = it.canvas.parentElement!;
    const r = box.getBoundingClientRect();
    if (!r.width || !r.height) return false;
    const dpr = window.devicePixelRatio || 1;
    const cellDev = Math.max(1, Math.round(Number(it.canvas.dataset.cell || 6) * dpr));
    const cellCss = cellDev / dpr;
    const cols = Math.min(it.life.w, Math.floor(r.width / cellCss));
    const rows = Math.min(it.life.h, Math.floor(r.height / cellCss));
    if (it.img && it.cols === cols && it.rows === rows) return true;
    it.cols = cols;
    it.rows = rows;
    it.canvas.width = cols;
    it.canvas.height = rows;
    it.canvas.style.width = `${cols * cellCss}px`;
    it.canvas.style.height = `${rows * cellCss}px`;
    // centre the grid, then land its edges on whole device pixels
    const left = Math.round((r.left + (r.width - cols * cellCss) / 2) * dpr) / dpr - r.left;
    const top = Math.round((r.top + (r.height - rows * cellCss) / 2) * dpr) / dpr - r.top;
    it.canvas.style.transform = `translate(${left}px, ${top}px)`;
    it.img = it.ctx.createImageData(cols, rows);
    return true;
  }

  function render(it: Inst) {
    if (!it.img && !layout(it)) return;
    const empty = draw(it.life, it.cols, it.rows, it.pal, it.img!.data);
    it.ctx.putImageData(it.img!, 0, 0);
    it.canvas.dataset.empty = empty.toFixed(3);
  }

  const running = (it: Inst) =>
    it.inView && !document.hidden && !reduce.matches && !it.canvas.closest('[data-dissolved]');

  function tick() {
    let any = false;
    for (const it of insts) {
      if (!running(it)) continue;
      any = true;
      const t0 = performance.now();
      it.life.step();
      render(it);
      const dt = performance.now() - t0;
      it.steps++;
      it.ms += dt;
      if (dt > it.maxMs) it.maxMs = dt;
      it.canvas.dataset.steps = String(it.steps);
      it.canvas.dataset.avgMs = (it.ms / it.steps).toFixed(3);
      it.canvas.dataset.maxMs = it.maxMs.toFixed(3);
    }
    if (!any) schedule();
  }

  /** run the shared timer only while at least one field is live */
  function schedule() {
    const live = insts.filter(running);
    const rate = live.length ? Math.max(...live.map((it) => Number(it.canvas.dataset.rate || 10))) : 0;
    if (rate === timerRate) return;
    clearInterval(timer);
    timerRate = rate;
    if (rate) timer = window.setInterval(tick, 1000 / rate);
    document.documentElement.dataset.ditherLive = String(live.length);
  }

  function teardown() {
    clearInterval(timer);
    timerRate = 0;
    io?.disconnect();
    ro?.disconnect();
    insts = [];
  }

  function init() {
    teardown();
    io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const it = insts.find((i) => i.canvas === e.target);
        if (it) it.inView = e.isIntersecting;
      }
      schedule();
    });
    ro = new ResizeObserver((entries) => {
      for (const e of entries) {
        const it = insts.find((i) => i.canvas.parentElement === e.target);
        if (it && layout(it)) render(it);
      }
    });
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-dither]').forEach((canvas) => {
      const life = createLife(canvas.dataset.seed || '/', undefined, undefined, false);
      decodeState(life, canvas.dataset.state || '');
      const it: Inst = {
        canvas,
        life,
        cols: 0,
        rows: 0,
        ctx: canvas.getContext('2d')!,
        pal: colours(Number(canvas.dataset.intensity || 1)),
        inView: false,
        steps: 0,
        ms: 0,
        maxMs: 0,
      };
      insts.push(it);
      layout(it);
      render(it);
      io!.observe(canvas);
      ro!.observe(canvas.parentElement!);
    });
    schedule();
  }

  document.addEventListener('visibilitychange', schedule);
  document.addEventListener('split:dissolve', schedule);
  reduce.addEventListener('change', schedule);
  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('astro:page-load', init);
</script>

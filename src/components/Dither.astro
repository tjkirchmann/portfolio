---
/**
 * Conway's Life at display resolution, one automaton cell per drawn square. Live cells are
 * solid emerald; a cell that dies leaves a trail that thins out through an 8x8 Bayer dither
 * (teal, then deep, then gone). Nothing is blurred or upscaled.
 *
 * The field is seeded from the page and pre-evolved at build time, then shipped as a small
 * state string, so the first paint is already a settled pattern. In the browser it steps
 * about 10 times a second and pauses off-screen, in hidden tabs, when the mobile art has
 * dissolved, and always under prefers-reduced-motion. Only whole cells are drawn, centred in
 * the box, so nothing is cut at the edges.
 */
import { createLife, encodeState, WARMUP } from '../lib/dither-sim';

interface Props {
  /** CSS px per cell (snapped to whole device pixels) */
  cell?: number;
  /** pattern seed; defaults to the page path so each page has its own */
  seed?: string;
  /** 0..1 strength of the greens over --bg, to keep the art on top the subject */
  intensity?: number;
  /** steps per second */
  rate?: number;
  class?: string;
}
const { cell = 6, seed = Astro.url.pathname, intensity = 1, rate = 10, class: className } = Astro.props;
const life = createLife(seed);
for (let i = 0; i < WARMUP; i++) life.step();
const state = encodeState(life);
---

<div class:list={['dither', className]} data-dither-box>
  <canvas
    data-dither
    data-seed={seed}
    data-cell={cell}
    data-intensity={intensity}
    data-rate={rate}
    data-state={state}
    aria-hidden="true"></canvas>
</div>

<style>
  .dither {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    background: var(--bg);
    transition: opacity var(--dur-3) var(--ease);
  }
  /* a piece with its own colour asks for the life backdrop to step aside */
  :global([data-no-backdrop]) .dither {
    opacity: 0;
  }
  canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
</style>

<script>
  import { createLife, decodeState, classify, colours, WARMUP, type Life } from '../lib/dither-sim';
  import { createMetal, type Metal } from '../lib/metal';
  import { openCarve, type Carve } from '../lib/carve';
  import { createTools, type Tools } from '../lib/tools';

  interface Inst {
    canvas: HTMLCanvasElement;
    life: Life;
    cols: number;
    rows: number;
    img?: ImageData;
    ctx?: CanvasRenderingContext2D;
    metal?: Metal | null;
    intensity: number;
    cells?: Uint8Array;
    pal: Uint8Array;
    inView: boolean;
    steps: number;
    ms: number;
    maxMs: number;
    /** the hover panel's room, while it is open */
    carve: Carve | null;
    /** a closed room whose frame cells are still walking back in */
    leaving: Carve | null;
    /** paint tools (menu in the same pane) */
    tools: Tools;
    tool: string | null;
    pane: HTMLElement;
    /** css px of the grid's top-left inside the box, and per cell */
    offX: number;
    offY: number;
    cellCss: number;
  }

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let insts: Inst[] = [];
  let timer = 0;
  let timerRate = 0;
  let io: IntersectionObserver | undefined;
  let ro: ResizeObserver | undefined;

  /** whole cells only, centred, cell edges on device pixels */
  function layout(it: Inst) {
    const box = it.canvas.parentElement!;
    const r = box.getBoundingClientRect();
    if (!r.width || !r.height) return false;
    const dpr = window.devicePixelRatio || 1;
    const cellDev = Math.max(1, Math.round(Number(it.canvas.dataset.cell || 6) * dpr));
    const cellCss = cellDev / dpr;
    const cols = Math.min(it.life.w, Math.floor(r.width / cellCss));
    const rows = Math.min(it.life.h, Math.floor(r.height / cellCss));
    if ((it.img || it.cells) && it.cols === cols && it.rows === rows) return true;
    it.cols = cols;
    it.rows = rows;
    it.cells = new Uint8Array(cols * rows * 4);
    if (it.metal) {
      it.metal.resize(cols, rows, cellDev);
    } else {
      it.canvas.width = cols;
      it.canvas.height = rows;
    }
    it.canvas.style.width = `${cols * cellCss}px`;
    it.canvas.style.height = `${rows * cellCss}px`;
    // centre the grid, then land its edges on whole device pixels
    const left = Math.round((r.left + (r.width - cols * cellCss) / 2) * dpr) / dpr - r.left;
    const top = Math.round((r.top + (r.height - rows * cellCss) / 2) * dpr) / dpr - r.top;
    it.canvas.style.transform = `translate(${left}px, ${top}px)`;
    it.offX = left;
    it.offY = top;
    it.cellCss = cellCss;
    if (!it.metal) it.img = it.ctx!.createImageData(cols, rows);
    // the grid changed under an open room: re-make it in place, no walk
    it.leaving?.commit();
    it.leaving = null;
    if (it.carve) {
      it.carve.release(performance.now(), true);
      it.carve = openCarve(it.life, cols, rows, performance.now(), true);
      announce(it);
    }
    return true;
  }

  /** tell the panel where its room is, in css px inside the box */
  function announce(it: Inst) {
    const c = it.carve;
    const box = it.canvas.parentElement!;
    const detail = c
      ? {
          open: true,
          left: it.offX + c.rect.x0 * it.cellCss,
          top: it.offY + c.rect.y0 * it.cellCss,
          width: (c.rect.x1 - c.rect.x0) * it.cellCss,
          height: (c.rect.y1 - c.rect.y0) * it.cellCss,
          settleAt: c.settleAt,
        }
      : { open: false };
    box.dispatchEvent(new CustomEvent('dither:room', { bubbles: true, detail }));
  }

  // the light's clock: real time while live, frozen (band mid-pane) under reduced motion
  const lightTime = () => (reduce.matches ? 9 : performance.now() / 1000);

  function render(it: Inst) {
    if (!it.img && !it.cells && !layout(it)) return;
    const now = performance.now();
    // per cell: the simulation, then the tools' passing effects, then the panel's room on top
    const empty = classify(it.life, it.cols, it.rows, it.cells!);
    it.tools.paint(it.cells!, now);
    it.leaving?.paint(it.cells!, now);
    it.carve?.paint(it.cells!, now);
    if (it.metal) {
      it.metal.upload(it.cells!);
      it.metal.draw(lightTime());
    } else {
      // flat fallback: the same cells coloured from the 2D palette (painted cells by ramp band)
      const c = it.cells!, out = it.img!.data;
      for (let i = 0; i < c.length; i += 4) {
        const v = c[i];
        if (!v) {
          out[i] = 10; out[i + 1] = 12; out[i + 2] = 11;
        } else {
          const fam = c[i + 2] ? (c[i + 2] < 140 ? 0 : c[i + 2] < 180 ? 1 : 2) : (c[i + 1] / 127) | 0;
          const k = fam * 3 + (v > 200 ? 0 : v > 120 ? 1 : 2);
          out[i] = it.pal[k * 3]; out[i + 1] = it.pal[k * 3 + 1]; out[i + 2] = it.pal[k * 3 + 2];
        }
        out[i + 3] = 255;
      }
      it.ctx!.putImageData(it.img!, 0, 0);
    }
    it.canvas.dataset.empty = empty.toFixed(3);
  }

  // the shared light moves at frame rate, but only while a metal field is live
  let raf = 0;
  function frame() {
    raf = 0;
    const live = insts.filter((it) => it.metal && running(it));
    if (!live.length) return;
    const t = lightTime();
    for (const it of live) it.metal!.draw(t);
    raf = requestAnimationFrame(frame);
  }
  function wakeLight() {
    if (!raf && insts.some((it) => it.metal && running(it))) raf = requestAnimationFrame(frame);
  }

  // while cells are walking or a tool is animating, redraw every frame (the Life step stays at
  // its own rate)
  let walkRaf = 0;
  function walkFrame() {
    walkRaf = 0;
    const now = performance.now();
    let more = false;
    for (const it of insts) {
      const fx = it.tools.frame(now);
      if (!it.carve && !it.leaving && !fx) continue;
      if (it.leaving?.done(now)) {
        it.leaving.commit();
        it.leaving = null;
      }
      render(it);
      if (fx || it.leaving || it.carve?.walking(now)) more = true;
    }
    if (more) walkRaf = requestAnimationFrame(walkFrame);
  }
  const wake = () => {
    if (!walkRaf) walkRaf = requestAnimationFrame(walkFrame);
  };

  function setRoom(it: Inst, open: boolean) {
    if (open === !!it.carve) return;
    const now = performance.now();
    if (open) {
      if (!it.cols && !layout(it)) return;
      // back before the old frame finished walking in: land it now, then make the new room
      it.leaving?.commit();
      it.leaving = null;
      // tools are suspended while the panel is up; a well goes at once, blasts run on outside
      it.tools.dropWell();
      it.tools.brushEnd();
      it.tools.flushBrush();
      it.carve = openCarve(it.life, it.cols, it.rows, now, reduce.matches);
    } else {
      it.carve!.release(now, reduce.matches);
      if (!reduce.matches) it.leaving = it.carve;
      it.carve = null;
    }
    announce(it);
    render(it);
    if (it.leaving || it.carve?.walking(now)) wake();
  }

  // ---- paint tools ----
  const fine = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 800px)');
  /** the phone play screen: the pane is full screen and the tools take touch */
  const playing = () => document.documentElement.hasAttribute('data-play');
  const suspended = (it: Inst) => !!(it.carve || it.leaving) || !(fine.matches || playing());
  const motionTool = (t: string | null) => t === 'gravity' || t === 'explode';

  function toCell(it: Inst, e: PointerEvent) {
    const r = it.canvas.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * it.cols, y: ((e.clientY - r.top) / r.height) * it.rows };
  }
  const onMenu = (e: Event) => !!(e.target as Element | null)?.closest?.('[data-tools]');

  function bindTools(it: Inst) {
    const pane = it.pane;
    let down = false;
    pane.addEventListener('pointerdown', (e) => {
      const touch = e.pointerType === 'touch';
      if ((touch && !playing()) || e.button !== 0 || !it.tool || suspended(it) || onMenu(e) || (e.target as Element)?.closest?.('button, a')) return;
      const c = toCell(it, e);
      if (it.tool === 'gravity' && touch && !reduce.matches) {
        // a finger carries the well only while it is down
        down = true;
        pane.setPointerCapture(e.pointerId);
        it.tools.well(c.x, c.y);
        wake();
        e.preventDefault();
        return;
      }
      if (it.tool === 'brush') {
        down = true;
        pane.setPointerCapture(e.pointerId);
        it.tools.brush(c.x, c.y, true);
        render(it);
        wake();
        e.preventDefault();
      } else if (it.tool === 'explode' && !reduce.matches) {
        it.tools.explode(c.x, c.y, performance.now());
        wake();
        e.preventDefault();
      }
    });
    pane.addEventListener('pointermove', (e) => {
      const touch = e.pointerType === 'touch';
      if ((touch && !playing()) || !it.tool) return;
      if (suspended(it)) return;
      if (touch && !down) return;
      if (it.tool === 'brush' && down) {
        const evs = e.getCoalescedEvents?.() ?? [e];
        for (const ce of evs.length ? evs : [e]) {
          const c = toCell(it, ce);
          it.tools.brush(c.x, c.y, false);
        }
        render(it);
      } else if (it.tool === 'gravity' && !reduce.matches) {
        if (onMenu(e)) return it.tools.well(null, null);
        const c = toCell(it, e);
        it.tools.well(c.x, c.y);
        wake();
      }
    });
    const up = (e: PointerEvent) => {
      if (!down) return;
      down = false;
      it.tools.brushEnd();
      if (e.pointerType === 'touch') {
        it.tools.well(null, null);
        wake();
      }
    };
    pane.addEventListener('pointerup', up);
    pane.addEventListener('pointercancel', up);
    pane.addEventListener('pointerleave', () => {
      it.tools.well(null, null);
      wake();
    });
  }

  function setTool(it: Inst, tool: string | null) {
    it.tool = tool;
    it.tools.well(null, null);
    it.tools.brushEnd();
    if (tool) it.pane.dataset.tool = tool;
    else delete it.pane.dataset.tool;
    wake();
  }

  /** a fresh pre-evolved field under a quick fade */
  function reseed(it: Inst) {
    const c = it.canvas;
    c.style.transition = 'opacity 140ms ease-out';
    c.style.opacity = '0';
    window.setTimeout(() => {
      const fresh = createLife(`${c.dataset.seed}:${Math.random().toString(36).slice(2)}`);
      for (let i = 0; i < WARMUP; i++) fresh.step();
      it.life.alive.set(fresh.alive);
      it.life.trail.set(fresh.trail);
      it.life.hue.set(fresh.hue);
      it.life.paint.fill(0);
      it.tools.clear();
      // keep an open room clear
      it.carve?.hold();
      render(it);
      c.style.transition = 'opacity 220ms ease-in';
      c.style.opacity = '1';
    }, reduce.matches ? 0 : 150);
  }

  const running = (it: Inst) =>
    it.inView &&
    !document.hidden &&
    !reduce.matches &&
    !it.canvas.closest('[data-dissolved]') &&
    !it.canvas.closest('[data-no-backdrop]');

  function tick() {
    let any = false;
    for (const it of insts) {
      if (!running(it)) continue;
      any = true;
      const t0 = performance.now();
      it.life.step();
      it.carve?.hold();
      it.tools.afterStep();
      render(it);
      const dt = performance.now() - t0;
      it.steps++;
      it.ms += dt;
      if (dt > it.maxMs) it.maxMs = dt;
      it.canvas.dataset.steps = String(it.steps);
      it.canvas.dataset.avgMs = (it.ms / it.steps).toFixed(3);
      it.canvas.dataset.maxMs = it.maxMs.toFixed(3);
    }
    if (!any) schedule();
  }

  /** run the shared timer only while at least one field is live */
  function schedule() {
    const live = insts.filter(running);
    const rate = live.length ? Math.max(...live.map((it) => Number(it.canvas.dataset.rate || 10))) : 0;
    if (rate === timerRate) return wakeLight();
    clearInterval(timer);
    timerRate = rate;
    if (rate) timer = window.setInterval(tick, 1000 / rate);
    document.documentElement.dataset.ditherLive = String(live.length);
    wakeLight();
  }

  /** full strength when the pane's current art view is the life-only one */
  function strength(canvas: HTMLCanvasElement) {
    const pane = canvas.closest('[data-split-art]') || canvas.parentElement?.parentElement;
    const none = pane?.querySelector('[data-art-piece]:not([data-inactive])[data-none]');
    return none ? 1 : Number(canvas.dataset.intensity || 1);
  }

  function teardown() {
    clearInterval(timer);
    cancelAnimationFrame(walkRaf);
    for (const it of insts) delete it.pane.dataset.tool;
    walkRaf = 0;
    cancelAnimationFrame(raf);
    raf = 0;
    timerRate = 0;
    io?.disconnect();
    ro?.disconnect();
    insts = [];
  }

  function init() {
    teardown();
    io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const it = insts.find((i) => i.canvas === e.target);
        if (it) it.inView = e.isIntersecting;
      }
      schedule();
    });
    ro = new ResizeObserver((entries) => {
      for (const e of entries) {
        const it = insts.find((i) => i.canvas.parentElement === e.target);
        if (it && layout(it)) render(it);
      }
    });
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-dither]').forEach((canvas) => {
      const life = createLife(canvas.dataset.seed || '/', undefined, undefined, false);
      decodeState(life, canvas.dataset.state || '');
      const intensity = strength(canvas);
      // WebGL metal if available; otherwise the flat 2D look
      let metal: Metal | null = null;
      try {
        metal = createMetal(canvas, intensity);
      } catch {
        metal = null;
      }
      canvas.dataset.renderer = metal ? 'webgl' : '2d';
      const pane = (canvas.closest('[data-split-art]') ?? canvas.parentElement!) as HTMLElement;
      const it: Inst = {
        canvas,
        life,
        cols: 0,
        rows: 0,
        metal,
        intensity,
        ctx: metal ? undefined : canvas.getContext('2d')!,
        pal: colours(intensity),
        inView: false,
        steps: 0,
        ms: 0,
        maxMs: 0,
        carve: null,
        leaving: null,
        offX: 0,
        offY: 0,
        cellCss: 6,
        tools: createTools(life, () => it),
        tool: null,
        pane,
      };
      insts.push(it);
      bindTools(it);
      layout(it);
      render(it);
      io!.observe(canvas);
      ro!.observe(canvas.parentElement!);
    });
    schedule();
  }

  document.addEventListener('visibilitychange', schedule);
  document.addEventListener('split:dissolve', schedule);
  document.addEventListener('dither:check', () => {
    // full strength when nothing is in front of it (the life-only art view), else as configured
    for (const it of insts) {
      const want = strength(it.canvas);
      if (want === it.intensity) continue;
      it.intensity = want;
      if (it.metal) it.metal.setIntensity(want);
      else it.pal = colours(want);
      render(it);
    }
    schedule();
  });
  reduce.addEventListener('change', schedule);
  // the home hover panel asks the field in its pane to make (or give back) a room
  document.addEventListener('dither:carve', (e) => {
    const { pane, open } = (e as CustomEvent<{ pane: Element; open: boolean }>).detail;
    for (const it of insts) if (pane.contains(it.canvas)) setRoom(it, open);
  });
  // the tool menu in a pane picks a tool (or none) and asks for a reset
  document.addEventListener('dither:tool', (e) => {
    const { pane, tool } = (e as CustomEvent<{ pane: Element; tool: string | null }>).detail;
    for (const it of insts) if (pane.contains(it.canvas)) setTool(it, motionTool(tool) && reduce.matches ? null : tool);
  });
  document.addEventListener('dither:reset', (e) => {
    const { pane } = (e as CustomEvent<{ pane: Element }>).detail;
    for (const it of insts) if (pane.contains(it.canvas)) reseed(it);
  });
  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('astro:page-load', init);
</script>

---
/**
 * A row of links along the bottom of the home text pane. A link with an `icon` shows as the
 * icon alone, in emerald, with its label as the accessible name and tooltip; others are text.
 * External links open in a new tab. A link with a `hint` shows it in a speech bubble above
 * the link while hovered or focused; one with `download` saves its file.
 */
import { icon } from '../lib/icons';
import Hints from './Hints.astro';

interface Props {
  links: { label: string; href: string; icon?: string; hint?: string; download?: boolean }[];
  label?: string;
}
const { links, label = 'Links' } = Astro.props;
const external = (href: string) => /^https?:/.test(href);
---

<nav class="linkrow" aria-label={label}>
  <ul>
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[{ 'is-icon': !!l.icon }]}
            aria-label={l.icon ? l.label : undefined}
            title={l.icon && !l.hint ? l.label : undefined}
            download={l.download ? '' : undefined}
            {...(external(l.href) ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {l.icon ? <Fragment set:html={icon(l.icon, 24)} /> : l.label}
          </a>
          {l.hint && (
            <span class="hint link-hint" data-tail="down" aria-hidden="true">
              {l.hint}
            </span>
          )}
        </li>
      ))
    }
  </ul>
</nav>
<Hints />

<style>
  .linkrow ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .linkrow li {
    position: relative;
  }
  /* the bubble above a hovered or focused link */
  .link-hint {
    position: absolute;
    left: 50%;
    bottom: calc(100% + var(--space-3));
    z-index: 3;
    transform: translateX(-50%);
    opacity: 0;
    visibility: hidden;
    animation: none;
    transition: opacity var(--dur-1) var(--ease), visibility 0s linear var(--dur-1);
  }
  .linkrow li:hover > .link-hint,
  .linkrow li:focus-within > .link-hint {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .linkrow a {
    display: inline-block;
    padding: var(--space-1) 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
    transition: color var(--dur-1) var(--ease);
  }
  .linkrow a:hover {
    color: var(--emerald);
  }
  .linkrow a.is-icon {
    display: grid;
    place-items: center;
    padding: var(--space-1);
    margin: 0 calc(-1 * var(--space-1));
    color: var(--emerald);
  }
  .linkrow a.is-icon:hover {
    color: color-mix(in oklab, var(--emerald) 70%, var(--ink));
  }
  .linkrow a.is-icon :global(svg) {
    display: block;
  }
  .linkrow a:focus-visible {
    outline-offset: 2px;
  }
</style>

---
/**
 * Hints: pixel speech bubbles that walk a visitor through the page, one at a time. Any element
 * with `data-hint="<name>" hidden` takes part. After every page load the steps run in ORDER
 * (skipping names the page does not have): the current step's bubble is shown, and when the
 * thing it points at is used it fades out and the next one comes in. A step used out of turn
 * is marked done and skipped. The shown bubble nudges gently toward its target.
 * Wide pointer screens only. The bubble style is global so other components can place a hint.
 */
---

<style is:global>
  /* a pixel-art speech bubble: stepped corners and a stepped tail on a 3px grid, light grey
     with a faint checker texture well below the text's contrast */
  .hint {
    --px: 3px;
    --bubble: #d3d7d2;
    position: relative;
    isolation: isolate;
    display: inline-block;
    padding: calc(var(--px) * 2) calc(var(--px) * 4);
    color: #0f1211;
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
    animation: hint-in 400ms var(--ease) both;
  }
  .hint::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      conic-gradient(rgb(0 0 0 / 0.05) 25%, transparent 0 50%, rgb(0 0 0 / 0.05) 0 75%, transparent 0) 0 0 /
        calc(var(--px) * 2) calc(var(--px) * 2),
      var(--bubble);
    clip-path: polygon(
      calc(var(--px) * 2) 0,
      calc(100% - var(--px) * 2) 0,
      calc(100% - var(--px) * 2) var(--px),
      calc(100% - var(--px)) var(--px),
      calc(100% - var(--px)) calc(var(--px) * 2),
      100% calc(var(--px) * 2),
      100% calc(100% - var(--px) * 2),
      calc(100% - var(--px)) calc(100% - var(--px) * 2),
      calc(100% - var(--px)) calc(100% - var(--px)),
      calc(100% - var(--px) * 2) calc(100% - var(--px)),
      calc(100% - var(--px) * 2) 100%,
      calc(var(--px) * 2) 100%,
      calc(var(--px) * 2) calc(100% - var(--px)),
      var(--px) calc(100% - var(--px)),
      var(--px) calc(100% - var(--px) * 2),
      0 calc(100% - var(--px) * 2),
      0 calc(var(--px) * 2),
      var(--px) calc(var(--px) * 2),
      var(--px) var(--px),
      calc(var(--px) * 2) var(--px)
    );
  }
  /* the tail: a three-step pixel wedge */
  .hint::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: calc(var(--px) * 3);
    height: calc(var(--px) * 3);
    background: var(--bubble);
  }
  .hint[data-tail='down']::after {
    top: 100%;
    left: calc(50% - var(--px) * 1.5);
    clip-path: polygon(0 0, 100% 0, 100% 33.34%, 66.67% 33.34%, 66.67% 66.67%, 33.34% 66.67%, 33.34% 100%, 0 100%);
  }
  .hint[data-tail='right']::after {
    left: 100%;
    top: calc(50% - var(--px) * 1.5);
    clip-path: polygon(0 0, 0 100%, 33.34% 100%, 33.34% 66.67%, 66.67% 66.67%, 66.67% 33.34%, 100% 33.34%, 100% 0);
  }
  .hint[data-tail='up']::after {
    bottom: 100%;
    left: calc(50% - var(--px) * 1.5);
    clip-path: polygon(0 0, 33.34% 0, 33.34% 33.34%, 66.67% 33.34%, 66.67% 66.67%, 100% 66.67%, 100% 100%, 0 100%);
  }
  /* tail near the bubble's right end, for bubbles hung from an icon at the right */
  .hint[data-tail='up'][data-tail-at='end']::after {
    left: auto;
    right: calc(var(--px) * 4);
    clip-path: polygon(100% 0, 66.67% 0, 66.67% 33.34%, 33.34% 33.34%, 33.34% 66.67%, 0 66.67%, 0 100%, 100% 100%);
  }
  .hint[data-tail='left']::after {
    right: 100%;
    top: calc(50% - var(--px) * 1.5);
    clip-path: polygon(100% 0, 100% 100%, 66.67% 100%, 66.67% 66.67%, 33.34% 66.67%, 33.34% 33.34%, 0 33.34%, 0 0);
  }
  .hint[hidden] {
    display: none;
  }
  /* the current step leans toward what it points at, a few pixels, in steps */
  .hint[data-hint] {
    --nudge: 0 0;
    /* arrives with a pop: there at once, a small overshoot, then settles; it grows out of
       the side its tail is on, so it seems to come from what it points at */
    transform-origin: 50% 50%;
    animation: hint-pop 340ms linear both, hint-nudge 1.5s steps(3, end) 700ms infinite alternate;
  }
  /* on arrival the bubble's fill (body and tail) flashes a soft yellow, twice: hard on, hard
     off, no easing, so it catches the eye */
  .hint[data-hint]::before,
  .hint[data-hint]::after {
    animation: hint-blink 340ms steps(1, end) 340ms 2;
  }
  .hint[data-hint][data-tail='down'] {
    --nudge: 0 3px;
    transform-origin: 50% 100%;
  }
  .hint[data-hint][data-tail='up'] {
    --nudge: 0 -3px;
    transform-origin: 50% 0;
  }
  .hint[data-hint][data-tail='up'][data-tail-at='end'] {
    transform-origin: 100% 0;
  }
  .hint[data-hint][data-tail='right'] {
    --nudge: 3px 0;
    transform-origin: 100% 50%;
  }
  .hint[data-hint][data-tail='left'] {
    --nudge: -3px 0;
    transform-origin: 0 50%;
  }
  /* satisfied: fades away before the next one arrives */
  .hint[data-hint][data-out] {
    animation: none;
    opacity: 0;
    transition: opacity 260ms var(--ease);
  }
  @keyframes hint-pop {
    0% {
      scale: 0.72;
    }
    38% {
      scale: 1.12;
    }
    62% {
      scale: 0.96;
    }
    82% {
      scale: 1.02;
    }
    100% {
      scale: 1;
    }
  }
  @keyframes hint-blink {
    0% {
      background-color: #f3e9a6;
    }
    50% {
      background-color: var(--bubble);
    }
  }
  @keyframes hint-nudge {
    to {
      translate: var(--nudge);
    }
  }
  @keyframes hint-in {
    from {
      opacity: 0;
    }
  }
  @media not ((hover: hover) and (pointer: fine) and (min-width: 800px)) {
    .hint {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hint,
    .hint[data-hint],
    .hint[data-hint]::before,
    .hint[data-hint]::after {
      animation: none;
    }
  }
</style>

<script>
  /** the order the hints are shown in after each page load */
  const ORDER = ['experiences', 'skills', 'skill-rows', 'about', 'tools'];
  const OUT = 260; // the satisfied hint's fade-out
  const NEXT = 1500; // from a step being satisfied to the next hint appearing

  let steps: string[] = [];
  let finished = new Set<string>();
  let started = false;
  let waiting = false; // between a step being satisfied and the next hint appearing
  let showT = 0, nextT = 0, roomT = 0;
  const ROOM_SETTLE = 700; // after the text panel closes: its frame walks back, the tool menu returns
  const roomOpen = () => !!document.querySelector('[data-room-open]');

  const all = (name: string) => Array.from(document.querySelectorAll<HTMLElement>(`[data-hint="${name}"]`));
  const current = () => steps.find((n) => !finished.has(n));

  /** show the current step's bubble and nothing else */
  function render() {
    if (!started || waiting) return;
    const cur = current();
    // the tools hint sits on the tool menu, which is away while the text panel is up
    const held = cur === 'tools' && roomOpen();
    document.querySelectorAll<HTMLElement>('[data-hint]').forEach((el) => {
      if (el.hasAttribute('data-out')) return;
      el.hidden = held || el.dataset.hint !== cur;
    });
  }

  function done(name: string) {
    if (finished.has(name) || !steps.includes(name)) return;
    const wasCurrent = started && current() === name;
    finished.add(name);
    if (!wasCurrent) return; // used out of turn: just skipped later
    for (const el of all(name)) {
      el.setAttribute('data-out', '');
      window.setTimeout(() => {
        el.hidden = true;
        el.removeAttribute('data-out');
      }, OUT);
    }
    clearTimeout(nextT);
    waiting = true;
    nextT = window.setTimeout(() => {
      waiting = false;
      render();
    }, NEXT);
  }

  document.addEventListener('astro:page-load', () => {
    clearTimeout(showT);
    clearTimeout(nextT);
    clearTimeout(roomT);
    finished = new Set();
    started = false;
    waiting = false;
    steps = ORDER.filter((n) => all(n).length);
    showT = window.setTimeout(() => {
      started = true;
      render();
    }, 1200);
  });

  for (const type of ['pointerover', 'focusin'])
    document.addEventListener(type, (e) => {
      const t = e.target as Element | null;
      if (!t?.closest) return;
      if (t.closest('[data-room-zone] [data-tl-item]')) done('experiences');
      const onSkills = !!t.closest('[data-tl-item="skills"]');
      if (onSkills) done('skills');
      if (t.closest('[data-room] .skill')) done('skill-rows');
      if (t.closest('[data-tl-item="about"]')) done('about');
      // the skills panel was left without trying a row: move on rather than stall
      if (current() === 'skill-rows' && !onSkills && !t.closest('[data-room]') && !document.querySelector('[data-room][data-open] .skills'))
        done('skill-rows');
    });
  document.addEventListener('dither:tool', (e) => {
    if ((e as CustomEvent).detail?.tool) done('tools');
  });
  document.addEventListener('dither:reset', () => done('tools'));

  // the panel copies its text from the page, so a bubble inside it needs syncing when it fills
  new MutationObserver(render).observe(document.documentElement, { subtree: true, childList: true });
  // the text panel opened or closed: hide a held hint at once, bring it back once things settle
  new MutationObserver(() => {
    clearTimeout(roomT);
    if (roomOpen()) render();
    else roomT = window.setTimeout(render, ROOM_SETTLE);
  }).observe(document.documentElement, { subtree: true, attributes: true, attributeFilter: ['data-room-open'] });
</script>

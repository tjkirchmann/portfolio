---
/**
 * Two-pane page shell. Default: text left, art right. `mirror`: art left, text right.
 * Desktop: the art pane is sticky at full viewport height while the text pane scrolls with the page.
 * Below 800px: the art fills the top of the screen, fixed behind the content, and dissolves over
 * the first --dissolve px of scroll (CSS scroll-driven animation, script fallback).
 */
import { fade } from 'astro:transitions';

interface Props {
  mirror?: boolean;
  label?: string;
  /**
   * Desktop shell (800px and wider). `scroll`: one viewport tall, the document never scrolls,
   * the text pane scrolls inside itself. `fit`: one viewport tall, nothing scrolls at this
   * level (children manage their own overflow). Unset: the document scrolls.
   */
  lock?: 'scroll' | 'fit';
}
const { mirror = false, label, lock } = Astro.props;
const side = mirror ? 'left' : 'right';
const textSide = mirror ? 'right' : 'left';
---

<div class="split" data-mirror={mirror ? '' : undefined} data-lock={lock}>
  <aside
    class="split-art"
    aria-label={label}
    data-split-art
    transition:name={`art-${side}`}
    transition:animate={fade({ duration: '400ms' })}
  >
    <div class="split-art-inner">
      <slot name="art" />
    </div>
    <div class="split-art-top">
      <slot name="art-top" />
    </div>
  </aside>
  <main
    class="split-text"
    id="main"
    tabindex={lock === 'scroll' ? -1 : undefined}
    data-pane={lock === 'scroll' ? '' : undefined}
    transition:name={`text-${textSide}`}
    transition:animate={fade({ duration: '260ms' })}
  >
    <slot />
  </main>
</div>

<style>
  .split {
    --cols: minmax(0, 1fr) minmax(0, 1.12fr);
    display: grid;
    grid-template-columns: var(--cols);
    min-height: 100dvh;
  }
  .split[data-mirror] {
    --cols: minmax(0, 0.86fr) minmax(0, 1.14fr);
  }
  .split:not([data-mirror]) .split-art { order: 2; }
  .split:not([data-mirror]) .split-text { order: 1; }

  .split-art {
    position: sticky;
    top: 0;
    height: 100dvh;
    padding: var(--pane-inset);
  }
  .split-art-inner {
    position: relative;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: #0c0f0e;
    /* hard clip to the rounded panel, including composited layers (canvas, video) */
    clip-path: inset(0 round var(--radius));
    display: grid;
    place-items: center;
    container-type: size;
  }
  .split-art-top {
    position: absolute;
    /* lines the back link up with the first line of the text pane */
    top: calc(var(--gutter) - var(--space-2));
    left: calc(var(--gutter) - var(--space-3));
  }
  .split-art-top:empty { display: none; }

  .split-text {
    min-width: 0;
    padding: var(--gutter);
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
  .split-text > :global(*) {
    width: 100%;
    max-width: 36rem;
  }

  @media (min-width: 800px) {
    .split[data-lock] {
      height: 100dvh;
      min-height: 0;
      overflow: hidden;
    }
    .split[data-lock] .split-text {
      height: 100dvh;
      min-height: 0;
    }
    .split[data-lock='fit'] .split-text {
      overflow: hidden;
    }
    .split[data-lock='scroll'] .split-text {
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: color-mix(in oklab, var(--ink) 16%, var(--bg)) transparent;
      padding-bottom: var(--space-9);
      --fade-top: 0px;
      --fade-bottom: 0px;
      mask-image: linear-gradient(to bottom, transparent 0, #000 var(--fade-top), #000 calc(100% - var(--fade-bottom)), transparent 100%);
    }
    .split[data-lock='scroll'] .split-text[data-more-above] { --fade-top: 3rem; }
    .split[data-lock='scroll'] .split-text[data-more-below] { --fade-bottom: 3rem; }
    .split[data-lock='scroll'] .split-text:focus { outline: none; }
    .split[data-lock='scroll'] .split-text::-webkit-scrollbar { width: 8px; }
    .split[data-lock='scroll'] .split-text::-webkit-scrollbar-thumb {
      background: color-mix(in oklab, var(--ink) 16%, var(--bg));
      border-radius: 8px;
      border: 2px solid var(--bg);
    }
  }

  @media (max-width: 799.98px) {
    .split {
      display: block;
      --art-h: 62svh;
    }
    .split-art {
      position: fixed;
      inset: 0 0 auto 0;
      height: var(--art-h);
      z-index: 0;
      opacity: calc(1 - var(--dissolve-p, 0));
      filter: blur(calc(var(--dissolve-p, 0) * 14px));
      visibility: var(--dissolve-vis, visible);
    }
    .split-art-top {
      top: calc(var(--pane-inset) + var(--space-3));
      left: calc(var(--pane-inset) + var(--space-3));
    }
    .split-text {
      position: relative;
      z-index: 1;
      margin-top: var(--art-h);
      min-height: calc(100svh - var(--art-h) + var(--dissolve));
      padding: var(--space-6) var(--gutter) var(--space-7);
    }
    @supports (animation-timeline: scroll()) {
      .split-art {
        opacity: 1;
        filter: none;
        visibility: visible;
        animation: split-dissolve linear both;
      }
      /* separate rule: keeps the minifier from folding the timeline into the shorthand,
         which Chrome rejects */
      .split > .split-art {
        animation-timeline: scroll(root block);
        animation-range: 0 var(--dissolve);
      }
    }
  }

  @keyframes split-dissolve {
    from { opacity: 1; filter: blur(0); visibility: visible; }
    to { opacity: 0; filter: blur(14px); visibility: hidden; }
  }

  @media (max-width: 799.98px) and (prefers-reduced-motion: reduce) {
    @supports (animation-timeline: scroll()) {
      /* scroll-linked, not timed: keep it, but the global reduce rule must not shorten it */
      .split-art { animation-duration: auto !important; }
    }
  }
</style>

<script>
  // Fallback for browsers without scroll-driven animations, and video pause when dissolved.
  const mq = window.matchMedia('(max-width: 799.98px)');
  const supportsTimeline = CSS.supports('animation-timeline: scroll()');
  let ticking = false;

  function dissolveDistance() {
    const v = getComputedStyle(document.documentElement).getPropertyValue('--dissolve');
    return parseFloat(v) || 120;
  }

  function update() {
    ticking = false;
    const pane = document.querySelector<HTMLElement>('[data-split-art]');
    if (!pane) return;
    const d = dissolveDistance();
    const p = mq.matches ? Math.min(1, Math.max(0, window.scrollY / d)) : 0;
    if (!supportsTimeline) {
      pane.style.setProperty('--dissolve-p', p.toFixed(3));
      pane.style.setProperty('--dissolve-vis', p >= 1 ? 'hidden' : 'visible');
    }
    const hidden = p >= 1;
    if (pane.hasAttribute('data-dissolved') !== hidden) {
      pane.toggleAttribute('data-dissolved', hidden);
      document.dispatchEvent(new CustomEvent('split:dissolve', { detail: { dissolved: hidden } }));
    }
    pane.querySelectorAll<HTMLVideoElement>('video[data-art-video]').forEach((v) => {
      if (hidden) {
        if (!v.paused) v.pause();
      } else if (v.dataset.wantsPlay === 'true' && v.paused) {
        v.play().catch(() => {});
      }
    });
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });

  // ---- Locked shell (desktop, lock="scroll"): the text pane is the only scroller ----
  const desk = window.matchMedia('(min-width: 800px)');
  let navType = 'load';
  const entryKey = () => `pane:${(history.state && history.state.index) ?? 'x'}:${location.pathname}`;

  function paneEl() {
    return document.querySelector<HTMLElement>('main[data-pane]');
  }
  function fades(pane: HTMLElement) {
    const max = pane.scrollHeight - pane.clientHeight;
    pane.toggleAttribute('data-more-above', pane.scrollTop > 1);
    pane.toggleAttribute('data-more-below', max - pane.scrollTop > 1);
  }
  let saveQueued = false;
  function save() {
    saveQueued = false;
    const pane = paneEl();
    if (!pane) return;
    try {
      sessionStorage.setItem(entryKey(), String(Math.round(pane.scrollTop)));
    } catch {}
  }

  function setupPane() {
    const pane = paneEl();
    if (!pane || !desk.matches) return;
    const fromHistory =
      navType === 'traverse' ||
      (navType === 'load' && (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type === 'back_forward');
    if (fromHistory && !location.hash) {
      let y = 0;
      try {
        y = Number(sessionStorage.getItem(entryKey()) || 0);
      } catch {}
      pane.scrollTop = y;
    } else if (!location.hash) {
      pane.scrollTop = 0;
    }
    // keyboard scrolling works without a click
    if (!document.activeElement || document.activeElement === document.body) pane.focus({ preventScroll: true });
    fades(pane);
    pane.addEventListener(
      'scroll',
      () => {
        fades(pane);
        if (!saveQueued) {
          saveQueued = true;
          requestAnimationFrame(save);
        }
      },
      { passive: true },
    );
    // wheel over the art pane scrolls the text pane
    document.querySelector<HTMLElement>('[data-split-art]')?.addEventListener(
      'wheel',
      (e) => {
        if (!desk.matches) return;
        pane.scrollBy({ top: e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY, left: 0 });
      },
      { passive: true },
    );
  }

  // If focus has fallen back to <body> (e.g. after clicking the art), keys still scroll the pane.
  document.addEventListener('keydown', (e) => {
    const pane = paneEl();
    if (!pane || !desk.matches || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
    const a = document.activeElement;
    if (a && a !== document.body && a !== document.documentElement) return;
    const page = pane.clientHeight * 0.88;
    const by: Record<string, number> = { ArrowDown: 48, ArrowUp: -48, PageDown: page, PageUp: -page, ' ': e.shiftKey ? -page : page };
    if (e.key === 'Home' || e.key === 'End') {
      pane.scrollTo({ top: e.key === 'Home' ? 0 : pane.scrollHeight });
    } else if (e.key in by) {
      pane.scrollBy({ top: by[e.key] });
    } else return;
    e.preventDefault();
    pane.focus({ preventScroll: true });
  });

  // Positions are saved as the pane scrolls. Not here: on back/forward the history entry has
  // already changed when this fires, so a save would land on the wrong entry.
  document.addEventListener('astro:before-preparation', (e) => {
    navType = (e as unknown as { navigationType: string }).navigationType;
  });
  window.addEventListener('pagehide', save);
  document.addEventListener('astro:page-load', setupPane);
  mq.addEventListener('change', update);
  document.addEventListener('astro:page-load', update);
  document.addEventListener('art:ready', update);
</script>
